# Python bytecode and cache directories
__pycache__/
*.py[cod]
*$py.class

# Test caches
.pytest_cache/

# Build artifacts
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# macOS
.DS_Store

# Runtime workspace created by AgentDB() defaults / tests
agentdb-workspace/

# Agent specs. Ignore the local working spec docs but TRACK the committed
# alignment deliverables under docs/spec/implementation/.
docs/spec/*
!docs/spec/implementation/

# Accidental literal ":memory:" path from ad-hoc scripts
:memory:
